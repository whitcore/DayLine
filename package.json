{
  "name": "dayline",
  "productName": "Dayline",
  "version": "1.5.3",
  "description": "Личное экранное время, настроение и итоги дня",
  "author": "Dayline",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "native": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "start": "npm run build && npm run native && electron .",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "node scripts/test-desktop.mjs",
    "test:installers": "node scripts/test-installers.mjs",
    "package": "npm run build && npm run native && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "lucide-react": "^0.468.0",
    "motion": "^14.10.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0",
    "vite": "^7.2.0"
  },
  "build": {
    "appId": "app.dayline.desktop",
    "productName": "Dayline",
    "asar": true,
    "directories": {
      "output": "release/1.5.3"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/ForegroundProbe.exe",
        "to": "ForegroundProbe.exe"
      },
      {
        "from": "assets/icon.png",
        "to": "icon.png"
      },
      {
        "from": "native/BrowserProbe.exe",
        "to": "BrowserProbe.exe"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": "nsis",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Dayline-Setup-${version}.${ext}"
    }
  }
}
